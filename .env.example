# =============================================================================
# VEXTOR CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env)
# =============================================================================

# --- CONFIGURACIÓN DE CORREO ELECTRÓNICO (SMTP) ---
# Para Gmail: Usar MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, y un 'App Password' de 16 caracteres.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-contrasena-de-aplicacion-gmail
MAIL_FROM=VEXTOR Fleet <tu-correo@gmail.com>

# --- URL DEL FRONTEND PARA ENLACES Y RECUPERACIÓN ---
# En desarrollo: http://localhost:5173
# En producción: https://mi-dominio-vextor.com
FRONTEND_URL=http://localhost:5173

# --- BASE DE DATOS POSTGRESQL ---
DATABASE_URL=postgresql+psycopg://vextor_user:Vextor7.!<>@localhost:5432/vextor_db

# --- SEGURIDAD Y JWT ---
JWT_SECRET_KEY=reemplaza-esta-clave-por-un-secreto-largo-y-aleatorio

# --- ROUTING OSRM PROPIO (utilizado únicamente por FastAPI) ---
# Desarrollo con infra/osrm/docker-compose.yml: http://localhost:5000
# Producción: URL interna de la instancia propia, por ejemplo http://osrm:5000
OSRM_URL=http://localhost:5000
OSRM_TIMEOUT_SECONDS=10
