# =============================================================================
# VEXTOR - PLANTILLA DE VARIABLES DE ENTORNO (.env)
# =============================================================================
# Copia este archivo a '.env' en la raíz de VEXTOR antes de iniciar el proyecto.

# --- BASE DE DATOS POSTGRESQL (SUPABASE / LOCAL) ---
# Formato: postgresql+psycopg://<usuario>:<password>@<host>:<puerto>/<database>
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/vextor_db

# --- SEGURIDAD Y TOKEN JWT ---
JWT_SECRET_KEY=reemplaza-esta-clave-por-un-secreto-largo-y-aleatorio-vextor-2025

# --- SERVIDOR DE ROUTING OSRM PROPIO ---
# En Docker Compose (backend -> osrm): http://osrm:5000
# En desarrollo local fuera de Docker: http://localhost:5000
OSRM_URL=http://osrm:5000
OSRM_TIMEOUT_SECONDS=10

# --- URL DEL FRONTEND CLIENTE ---
# Usada para generar enlaces de recuperación de contraseña y redirecciones
FRONTEND_URL=http://localhost:5173

# --- CONFIGURACIÓN DE URLS Y SERVICIOS FRONTEND (BUILD VITE) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# API Key pública de TomTom Traffic para capa de tráfico vehicular en tiempo real (opcional)
VITE_TOMTOM_API_KEY=

# --- CONFIGURACIÓN DE CORREO ELECTRÓNICO (SMTP GMAIL) ---
# Para Gmail, activa la verificación en dos pasos en tu cuenta Google y genera
# una "Contraseña de Aplicación" de 16 caracteres en https://myaccount.google.com/apppasswords.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=abcd-efgh-ijkl-mnop
MAIL_FROM=VEXTOR Fleet Management <tu-correo@gmail.com>
